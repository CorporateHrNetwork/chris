// CHRIS Prisma Schema
// CorporateHr Information System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String  @id @default(uuid())
  name               String
  slug               String  @unique
  legalName          String?
  email              String?
  phone              String?
  country            String?
  timezone           String  @default("Africa/Lagos")
  currency           String  @default("NGN")
  code               String?
  registrationNumber String?
  taxNumber          String?
  industry           String?
  organizationType   String?
  website            String?
  logoUrl            String?

  // Permanent organization-level Employee ID sequence.
  // Once a number is issued, it is never reused.
  employeeNumberSequence Int @default(0)

  status OrganizationStatus @default(ACTIVE)

  users                       User[]
  roles                       Role[]
  departments                 Department[]
  designations                Designation[]
  employmentLevels            OrganizationEmploymentLevel[]
  employees                   Employee[]
  locations                   OrganizationLocation[]
  employmentEpisodes          EmployeeEmploymentEpisode[]
  employeeLifecycleEvents     EmployeeLifecycleEvent[]
  attendancePayrollSetting    AttendancePayrollSetting?
  attendancePayrollInputs     AttendancePayrollInput[]
  designationLifecycleEvents  DesignationLifecycleEvent[]
  leaveTypes                  LeaveType[]
  leavePolicies               LeavePolicy[]
  leavePolicyAudits           LeavePolicyAudit[]
  leaveBalances               LeaveBalance[]
  leaveRequests               LeaveRequest[]
  leaveEntitlementAdjustments LeaveEntitlementAdjustment[]
  leaveEntitlementMatrixRules LeaveEntitlementMatrixRule[]
  leaveEntitlementAllocations LeaveEntitlementAllocation[]
  workShifts                  WorkShift[]
  employeeShiftAssignments    EmployeeShiftAssignment[]
  attendanceRecords           AttendanceRecord[]
  onboardingWorkflowTemplates OnboardingWorkflowTemplate[]
  employeeOnboardings         EmployeeOnboarding[]
  employeeOnboardingTasks     EmployeeOnboardingTask[]
  employeeDocuments           EmployeeDocument[]
  employeeExitProcesses       EmployeeExitProcess[]
  lineManagerAssignments      EmployeeLineManagerAssignment[]
  workforceSnapshots          WorkforceSnapshot[]
  organizationAudits          OrganizationAudit[]
  costCentres                 CostCentre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model OrganizationAudit {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  previousValue  Json?
  newValue       Json?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OrganizationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("organization_audits")
}

model CostCentre {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  status         CostCentreStatus @default(ACTIVE)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  employees    Employee[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("cost_centres")
}

model WorkforceSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  snapshotDate   DateTime

  totalCurrent    Int
  activeCount     Int
  probationCount  Int
  leaveCount      Int
  suspendedCount  Int
  totalHistorical Int
  exitedCount     Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, snapshotDate])
  @@index([organizationId, snapshotDate])
  @@map("workforce_snapshots")
}

model OrganizationLocation {
  id             String @id @default(uuid())
  organizationId String

  name String
  code String?

  type LocationType @default(BRANCH)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?

  phone String?
  email String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees     Employee[]
  userLocations UserLocation[]

  lifecycleEventsFrom EmployeeLifecycleEvent[] @relation("LifecycleFromLocation")
  lifecycleEventsTo   EmployeeLifecycleEvent[] @relation("LifecycleToLocation")

  employmentEpisodesStarted EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeStartLocation")
  employmentEpisodesEnded   EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeEndLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([type])
  @@index([isActive])
  @@map("organization_locations")
}

model User {
  id             String  @id @default(uuid())
  organizationId String
  employeeId     String? @unique
  email          String
  passwordHash   String
  firstName      String?
  lastName       String?
  isActive       Boolean @default(true)

  // WHAT the user may do is controlled by Roles/Permissions.
  // WHERE the user may do it is controlled here.
  //
  // ALL_LOCATIONS:
  // Organization-wide access.
  //
  // ASSIGNED_LOCATIONS:
  // Access only to locations linked through UserLocation.

  locationScope UserLocationScope @default(ALL_LOCATIONS)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  userRoles           UserRole[]
  passwordResetTokens PasswordResetToken[]
  userLocations       UserLocation[]

  performedLifecycleEvents            EmployeeLifecycleEvent[]        @relation("LifecyclePerformedBy")
  performedDesignationLifecycleEvents DesignationLifecycleEvent[]     @relation("DesignationLifecyclePerformedBy")
  attendancePayrollSettingsUpdated    AttendancePayrollSetting[]      @relation("AttendancePayrollSettingUpdatedBy")
  attendancePayrollInputsRecorded     AttendancePayrollInput[]        @relation("AttendancePayrollInputRecordedBy")
  createdLeaveRequests                LeaveRequest[]                  @relation("LeaveRequestCreatedBy")
  reviewedLeaveRequests               LeaveRequest[]                  @relation("LeaveRequestReviewedBy")
  leavePoliciesCreated                LeavePolicy[]                   @relation("LeavePolicyCreatedBy")
  leavePoliciesApproved               LeavePolicy[]                   @relation("LeavePolicyApprovedBy")
  leavePolicyAudits                   LeavePolicyAudit[]
  leaveEntitlementAdjustmentsCreated  LeaveEntitlementAdjustment[]    @relation("LeaveEntitlementAdjustmentCreatedBy")
  leaveEntitlementMatrixRulesCreated  LeaveEntitlementMatrixRule[]    @relation("LeaveEntitlementMatrixRuleCreatedBy")
  leaveEntitlementAllocationsCreated  LeaveEntitlementAllocation[]    @relation("LeaveEntitlementAllocationCreatedBy")
  commencedLeaveRequests              LeaveRequest[]                  @relation("LeaveRequestCommencedBy")
  returnedLeaveRequests               LeaveRequest[]                  @relation("LeaveRequestReturnedBy")
  recordedAttendanceRecords           AttendanceRecord[]              @relation("AttendanceRecordedBy")
  onboardingTemplatesCreated          OnboardingWorkflowTemplate[]    @relation("OnboardingTemplateCreatedBy")
  employeeOnboardingsAssigned         EmployeeOnboarding[]            @relation("EmployeeOnboardingAssignedTo")
  employeeOnboardingsCreated          EmployeeOnboarding[]            @relation("EmployeeOnboardingCreatedBy")
  employeeOnboardingsCompleted        EmployeeOnboarding[]            @relation("EmployeeOnboardingCompletedBy")
  employeeDocumentsUploaded           EmployeeDocument[]              @relation("EmployeeDocumentUploadedBy")
  onboardingTasksOwned                EmployeeOnboardingTask[]        @relation("EmployeeOnboardingTaskOwner")
  onboardingTasksCompleted            EmployeeOnboardingTask[]        @relation("EmployeeOnboardingTaskCompletedBy")
  employeeExitProcessesInitiated      EmployeeExitProcess[]           @relation("EmployeeExitInitiatedBy")
  employeeExitProcessesCompleted      EmployeeExitProcess[]           @relation("EmployeeExitCompletedBy")
  employeeExitProcessesCancelled      EmployeeExitProcess[]           @relation("EmployeeExitCancelledBy")
  lineManagerAssignmentsPerformed     EmployeeLineManagerAssignment[] @relation("LineManagerAssignmentPerformedBy")
  organizationAuditsPerformed         OrganizationAudit[]             @relation("OrganizationAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([locationScope])
  @@map("users")
}

model UserLocation {
  id String @id @default(uuid())

  organizationId String
  userId         String
  locationId     String

  // Composite relationships provide database-level
  // tenant safety.
  //
  // User and assigned location must belong to the
  // same organization.

  user     User                 @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, locationId])
  @@index([organizationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_locations")
}

model Role {
  id             String  @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystemRole   Boolean @default(false)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Department {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  code           String?
  description    String?
  isActive       Boolean @default(true)
  costCentreId   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCentre   CostCentre?  @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: Restrict)

  employees    Employee[]
  designations Designation[]

  previousDepartmentEvents EmployeeLifecycleEvent[] @relation("LifecyclePreviousDepartment")
  newDepartmentEvents      EmployeeLifecycleEvent[] @relation("LifecycleNewDepartment")

  employmentEpisodesStarted EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeStartDepartment")
  employmentEpisodesEnded   EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeEndDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([costCentreId])
  @@map("departments")
}

model Designation {
  id             String  @id @default(uuid())
  organizationId String
  departmentId   String?
  name           String
  code           String?
  description    String?
  isActive       Boolean @default(true)

  // Career hierarchy configuration.
  //
  // careerTrack groups related jobs into a progression path,
  // for example: HUMAN_RESOURCES, FINANCE, OPERATIONS.
  //
  // careerLevel is an ascending numeric level. A designation
  // with a higher number is above one with a lower number.
  // Null means the designation has not yet been mapped into
  // a formal career hierarchy.

  careerTrack String?
  careerLevel Int?

  // Optional immediate next / supervisory designation in the
  // career structure. CHRIS will not rely on this field alone
  // for promotion eligibility; careerLevel remains the primary
  // ordering mechanism.

  reportsToDesignationId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Department ownership of this designation.
  //
  // departmentId is nullable during the transition so existing
  // designation records can be mapped by the organization admin.
  //
  // organizationId + departmentId guarantees that a designation
  // cannot be linked to another tenant's department.

  department      Department?                  @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  employmentLevel OrganizationEmploymentLevel? @relation(fields: [organizationId, careerLevel], references: [organizationId, levelNumber], onDelete: Restrict)

  employees Employee[]

  reportsToDesignation Designation? @relation("DesignationCareerHierarchy", fields: [organizationId, reportsToDesignationId], references: [organizationId, id], onDelete: Restrict)

  subordinateDesignations Designation[] @relation("DesignationCareerHierarchy")

  previousDesignationEvents EmployeeLifecycleEvent[] @relation("LifecyclePreviousDesignation")
  newDesignationEvents      EmployeeLifecycleEvent[] @relation("LifecycleNewDesignation")

  employmentEpisodesStarted EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeStartDesignation")
  employmentEpisodesEnded   EmployeeEmploymentEpisode[] @relation("EmploymentEpisodeEndDesignation")

  lifecycleEvents DesignationLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([departmentId])
  @@index([organizationId, departmentId])
  @@index([careerTrack])
  @@index([careerLevel])
  @@index([reportsToDesignationId])
  @@index([organizationId, careerTrack, careerLevel])
  @@map("designations")
}

/// Tenant-owned metadata for the numeric Designation.careerLevel hierarchy.
/// Designation.careerLevel remains the authoritative employee-level mapping.
model OrganizationEmploymentLevel {
  organizationId String
  levelNumber    Int
  name           String
  code           String
  description    String?
  displayOrder   Int     @default(0)
  isActive       Boolean @default(true)

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designations Designation[]
  matrixRules  LeaveEntitlementMatrixRule[]
  allocations  LeaveEntitlementAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, levelNumber])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("organization_employment_levels")
}

enum EmployeeGender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model Employee {
  id             String  @id @default(uuid())
  organizationId String
  departmentId   String?
  designationId  String?
  locationId     String?
  costCentreId   String?

  employeeNumber String
  firstName      String
  middleName     String?
  lastName       String

  email  String?
  phone  String?
  gender EmployeeGender @default(UNSPECIFIED)

  status EmployeeStatus @default(ACTIVE)

  hireDate          DateTime?
  confirmationDate  DateTime?
  suspensionEndDate DateTime?
  exitDate          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  // Tenant-safe composite relationship.
  //
  // organizationId on Employee must match organizationId
  // on OrganizationLocation.
  //
  // Locations with historical employee records should
  // normally be deactivated rather than deleted.

  location   OrganizationLocation? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  costCentre CostCentre?           @relation(fields: [organizationId, costCentreId], references: [organizationId, id], onDelete: Restrict)

  user User?

  employmentEpisodes          EmployeeEmploymentEpisode[]
  lifecycleEvents             EmployeeLifecycleEvent[]
  attendancePayrollInputs     AttendancePayrollInput[]
  leaveBalances               LeaveBalance[]
  leaveRequests               LeaveRequest[]
  leaveEntitlementAdjustments LeaveEntitlementAdjustment[]
  leaveEntitlementAllocations LeaveEntitlementAllocation[]
  shiftAssignments            EmployeeShiftAssignment[]
  attendanceRecords           AttendanceRecord[]
  onboardings                 EmployeeOnboarding[]
  documents                   EmployeeDocument[]
  exitProcesses               EmployeeExitProcess[]
  lineManagerAssignments      EmployeeLineManagerAssignment[] @relation("LineManagerAssignmentEmployee")
  managedEmployeeAssignments  EmployeeLineManagerAssignment[] @relation("LineManagerAssignmentManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nationalIdentificationNumber String?

  @@unique([organizationId, nationalIdentificationNumber])
  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([departmentId])
  @@index([designationId])
  @@index([locationId])
  @@index([costCentreId])
  @@index([status])
  @@map("employees")
}

model EmployeeLineManagerAssignment {
  id                String    @id @default(uuid())
  organizationId    String
  employeeId        String
  managerEmployeeId String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  reason            String?
  notes             String?
  performedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LineManagerAssignmentEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  manager      Employee     @relation("LineManagerAssignmentManager", fields: [organizationId, managerEmployeeId], references: [organizationId, id], onDelete: Restrict)
  performedBy  User?        @relation("LineManagerAssignmentPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, managerEmployeeId])
  @@index([employeeId, effectiveFrom])
  @@index([managerEmployeeId, effectiveTo])
  @@index([performedByUserId])
  @@map("employee_line_manager_assignments")
}

model EmployeeEmploymentEpisode {
  id String @id @default(uuid())

  organizationId String
  employeeId     String

  // Permanent sequence of employment periods for this employee.
  // Episode 1 = original employment.
  // Episode 2+ = genuine rehire periods.
  sequenceNumber Int

  startDate DateTime
  endDate   DateTime?

  startStatus EmployeeStatus
  endStatus   EmployeeStatus?

  startDepartmentId String?
  endDepartmentId   String?

  startDesignationId String?
  endDesignationId   String?

  startLocationId String?
  endLocationId   String?

  // Why this employment period started / ended.
  // Examples:
  // startReason: "Initial employment", "Rehired after resignation"
  // endReason: "Voluntary resignation", "Retirement"
  startReason String?
  endReason   String?

  notes String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  startDepartment Department? @relation("EmploymentEpisodeStartDepartment", fields: [organizationId, startDepartmentId], references: [organizationId, id], onDelete: Restrict)

  endDepartment Department? @relation("EmploymentEpisodeEndDepartment", fields: [organizationId, endDepartmentId], references: [organizationId, id], onDelete: Restrict)

  startDesignation Designation? @relation("EmploymentEpisodeStartDesignation", fields: [organizationId, startDesignationId], references: [organizationId, id], onDelete: Restrict)

  endDesignation Designation? @relation("EmploymentEpisodeEndDesignation", fields: [organizationId, endDesignationId], references: [organizationId, id], onDelete: Restrict)

  startLocation OrganizationLocation? @relation("EmploymentEpisodeStartLocation", fields: [organizationId, startLocationId], references: [organizationId, id], onDelete: Restrict)

  endLocation OrganizationLocation? @relation("EmploymentEpisodeEndLocation", fields: [organizationId, endLocationId], references: [organizationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, sequenceNumber])
  @@index([organizationId])
  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([startDepartmentId])
  @@index([endDepartmentId])
  @@index([startDesignationId])
  @@index([endDesignationId])
  @@index([startLocationId])
  @@index([endLocationId])
  @@map("employee_employment_episodes")
}

model EmployeeLifecycleEvent {
  id String @id @default(uuid())

  organizationId String
  employeeId     String

  eventType EmployeeLifecycleEventType

  // Effective date of the HR event.
  //
  // This may differ from createdAt.
  // createdAt records when the transaction was entered
  // into CHRIS.

  effectiveDate     DateTime
  suspensionEndDate DateTime?

  // Status change information.

  previousStatus EmployeeStatus?
  newStatus      EmployeeStatus?

  // Location movement information.
  //
  // These fields allow the same history table to record
  // Head Office ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ Lagos ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ Port Harcourt transfers.

  fromLocationId String?
  toLocationId   String?

  // Department / job movement information.
  //
  // These fields preserve structured department changes for
  // promotions and future job-movement transactions.

  previousDepartmentId String?
  newDepartmentId      String?

  // Designation / job-title movement information.

  previousDesignationId String?
  newDesignationId      String?

  // HR explanation / supporting information.

  reason String?
  notes  String?

  // User who performed the transaction.
  //
  // User.id is globally unique, therefore this relation
  // does not need to include organizationId in the foreign
  // key. The lifecycle event itself remains organization-
  // scoped through organizationId.

  performedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  fromLocation OrganizationLocation? @relation("LifecycleFromLocation", fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict)

  toLocation OrganizationLocation? @relation("LifecycleToLocation", fields: [organizationId, toLocationId], references: [organizationId, id], onDelete: Restrict)

  previousDepartment Department? @relation("LifecyclePreviousDepartment", fields: [organizationId, previousDepartmentId], references: [organizationId, id], onDelete: Restrict)

  newDepartment Department? @relation("LifecycleNewDepartment", fields: [organizationId, newDepartmentId], references: [organizationId, id], onDelete: Restrict)

  previousDesignation Designation? @relation("LifecyclePreviousDesignation", fields: [organizationId, previousDesignationId], references: [organizationId, id], onDelete: Restrict)

  newDesignation Designation? @relation("LifecycleNewDesignation", fields: [organizationId, newDesignationId], references: [organizationId, id], onDelete: Restrict)

  performedBy User? @relation("LifecyclePerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@index([eventType])
  @@index([effectiveDate])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([previousDepartmentId])
  @@index([newDepartmentId])
  @@index([previousDesignationId])
  @@index([newDesignationId])
  @@index([performedByUserId])
  @@index([suspensionEndDate])
  @@map("employee_lifecycle_events")
}

// ============================================================
// LEAVE & ATTENDANCE MANAGEMENT
// Sprint 2A Foundation
// ============================================================

model LeaveType {
  id             String @id @default(uuid())
  organizationId String

  name        String
  code        String
  description String?

  unit LeaveUnit @default(DAYS)

  isPaid   Boolean @default(true)
  isActive Boolean @default(true)

  requiresAttachment Boolean @default(false)
  allowsHalfDay      Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  policies               LeavePolicy[]
  balances               LeaveBalance[]
  requests               LeaveRequest[]
  entitlementAdjustments LeaveEntitlementAdjustment[]
  entitlementMatrixRules LeaveEntitlementMatrixRule[]
  entitlementAllocations LeaveEntitlementAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([isActive])
  @@map("leave_types")
}

model LeavePolicyTemplate {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  category      String?
  jurisdiction  String?
  configuration Json
  previewText   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@map("leave_policy_templates")
}

model LeavePolicy {
  id             String @id @default(uuid())
  organizationId String
  leaveTypeId    String

  name         String
  code         String?
  description  String?
  category     String?
  jurisdiction String?

  status             LeavePolicyStatus     @default(ACTIVE)
  origin             LeavePolicyOrigin     @default(ORGANIZATION)
  complianceStatus   LeaveComplianceStatus @default(CUSTOM_NOT_ASSESSED)
  complianceNotes    String?
  versionGroupId     String?
  versionNumber      Int                   @default(1)
  changeReason       String?
  sourceTemplateCode String?
  createdByUserId    String?
  approvedByUserId   String?
  approvedAt         DateTime?

  eligibilityRules   Json    @default("{}")
  entitlementRules   Json    @default("{}")
  serviceBands       Json    @default("[]")
  balanceRules       Json    @default("{}")
  requestRules       Json    @default("{}")
  approvalWorkflow   Json    @default("{}")
  lifecycleRules     Json    @default("{}")
  payrollRules       Json    @default("{}")
  attendanceRules    Json    @default("{}")
  calendarRules      Json    @default("{}")
  documentationRules Json    @default("{}")
  overlapRules       Json    @default("{}")
  coverageRules      Json    @default("{}")
  previewText        String?

  entitlementDays Decimal @db.Decimal(8, 2)

